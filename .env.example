# Modelo do Ollama a ser utilizado pelo agente.
# Exemplo: qwen2.5:7b, llama3.1:8b, mistral:7b
OLLAMA_MODEL=
# Opcional
OLLAMA_TIMEOUT_SECONDS=60

# Segredo usado para assinar aprovações humanas; nunca preencher com valor real no repositório.
HUMAN_APPROVAL_SECRET=

# Webhook externo do Flowise; deixar vazio desabilita o encaminhamento.
# Cole a URL exibida pelo Webhook Trigger após publicar o AgentFlow.
FLOWISE_WEBHOOK_URL=
FLOWISE_TIMEOUT_SECONDS=10
