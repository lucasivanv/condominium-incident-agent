          "customFunctionInputVariables": [{"variableName":"triage","variableValue":"<p><span class=\"variable\" data-type=\"mention\" data-id=\"customFunctionAgentflow_1\" data-label=\"customFunctionAgentflow_1\">{{ customFunctionAgentflow_1.output.content }}</span></p>"}],
          "customFunctionJavascriptFunction": "const result = typeof $triage === 'string' ? (() => { try { return JSON.parse($triage); } catch (_) { return {}; } })() : $triage;\nconst correlationId = result.correlation_id || null;\nreturn JSON.stringify({status:result.status || 'REJECTED',occurrence_id:result.occurrence_id || null,correlation_id:correlationId,action:result.action || null,priority:result.priority || null,responsible_team:result.responsible_team || null,sla_minutes:Number.isInteger(result.sla_minutes) ? result.sla_minutes : null,alert_required:result.alert_required === true,diagnostic_summary:result.diagnostic_summary || null,audit_record_id:correlationId ? 'flowise-' + correlationId : null,error:Array.isArray(result.errors) && result.errors.length ? result.errors : null,processed_at:new Date().toISOString()});",
          "customFunctionUpdateState": []
        },
        "outputAnchors": [{"id":"customFunctionAgentflow_2-output-customFunctionAgentflow","label":"Custom Function","name":"customFunctionAgentflow"}],
